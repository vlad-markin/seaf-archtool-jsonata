{"id": "t-undef-map-null", "expr": "$map(null, function($v){$type($v)})", "tags": ["targeted"]}
{"id": "t-undef-sort-null", "expr": "$sort(null)", "tags": ["targeted"]}
{"id": "t-undef-reduce-null", "expr": "$reduce(null, function($a,$b){$a})", "tags": ["targeted"]}
{"id": "t-undef-string-nullpath", "expr": "$string(a)", "tags": ["targeted"], "input": {"a": null}}
{"id": "t-undef-exists-nullpath", "expr": "$exists(a)", "tags": ["targeted"], "input": {"a": null}}
{"id": "t-undef-type-nullpath", "expr": "$type(a)", "tags": ["targeted"], "input": {"a": null}}
{"id": "t-undef-filter-null", "expr": "$filter([null, 1], function($v){$v = null})", "tags": ["targeted"]}
{"id": "t-undef-null-arith", "expr": "null + 1", "tags": ["targeted"]}
{"id": "t-undef-null-concat", "expr": "null & 'x'", "tags": ["targeted"]}
{"id": "t-undef-null-eq", "expr": "a = null", "tags": ["targeted"], "input": {"a": null}}
{"id": "t-undef-path-null-arr", "expr": "a.b", "tags": ["targeted"], "input": {"a": [{"b": null}, {"b": 1}]}}
{"id": "t-undef-arr-null", "expr": "[null]", "tags": ["targeted"]}
{"id": "t-undef-obj-undef", "expr": "{'a': nothing, 'b': null}", "tags": ["targeted"]}
{"id": "t-undef-arr-undef", "expr": "[1, nothing, 2]", "tags": ["targeted"]}
{"id": "t-undef-single-null", "expr": "$single([null])", "tags": ["targeted"]}
{"id": "t-undef-distinct-null", "expr": "$distinct([null, null, 1])", "tags": ["targeted"]}
{"id": "t-undef-keys-null", "expr": "$keys({'a':null})", "tags": ["targeted"]}
{"id": "t-undef-lookup-null", "expr": "$lookup({'a':null}, 'a')", "tags": ["targeted"]}
{"id": "t-undef-sum-null", "expr": "$sum([1, null])", "tags": ["targeted"]}
{"id": "t-undef-boolean-null", "expr": "$boolean(null)", "tags": ["targeted"]}
{"id": "t-undef-not-null", "expr": "$not(null)", "tags": ["targeted"]}
{"id": "t-undef-append-null", "expr": "$append(null, 1)", "tags": ["targeted"]}
{"id": "t-undef-zip-null", "expr": "$zip(null)", "tags": ["targeted"]}
{"id": "t-undef-uppercase-null", "expr": "$uppercase(null)", "tags": ["targeted"]}
{"id": "t-undef-length-nullpath", "expr": "$length(a)", "tags": ["targeted"], "input": {"a": null}}
{"id": "t-undef-sift-null", "expr": "$sift(null, function($v){true})", "tags": ["targeted"]}
{"id": "t-undef-each-nullobj", "expr": "$each({'a':null}, function($v,$k){$type($v)})", "tags": ["targeted"]}
{"id": "t-undef-merge-null", "expr": "$merge([{'a':1}, null])", "tags": ["targeted"]}
{"id": "t-undef-spread-null", "expr": "$spread(null)", "tags": ["targeted"]}
{"id": "t-seq-single-path", "expr": "a.b", "tags": ["targeted"], "input": {"a": [{"b": 1}]}}
{"id": "t-seq-single-path-arr", "expr": "a.b", "tags": ["targeted"], "input": {"a": [{"b": [1]}]}}
{"id": "t-seq-keep-arr", "expr": "a.b[]", "tags": ["targeted"], "input": {"a": [{"b": 1}]}}
{"id": "t-seq-map-single", "expr": "$map([1], function($v){$v})", "tags": ["targeted"]}
{"id": "t-seq-filter-single", "expr": "$filter([1,2], function($v){$v>1})", "tags": ["targeted"]}
{"id": "t-seq-sort-single", "expr": "$sort([1])", "tags": ["targeted"]}
{"id": "t-seq-reverse-single", "expr": "$reverse([1])", "tags": ["targeted"]}
{"id": "t-seq-append-single", "expr": "$append([], 1)", "tags": ["targeted"]}
{"id": "t-seq-distinct-single", "expr": "$distinct([1,1])", "tags": ["targeted"]}
{"id": "t-seq-split-single", "expr": "$split('a', ',')", "tags": ["targeted"]}
{"id": "t-seq-keys-single", "expr": "$keys({'a':1})", "tags": ["targeted"]}
{"id": "t-seq-match-single", "expr": "$match('a', /a/)", "tags": ["targeted"]}
{"id": "t-seq-wild-single", "expr": "$.*", "tags": ["targeted"], "input": {"a": 1}}
{"id": "t-seq-desc-single", "expr": "**.b", "tags": ["targeted"], "input": {"a": {"b": 1}}}
{"id": "t-seq-group-single", "expr": "items{n: k}", "tags": ["targeted"], "input": {"items": [{"k": 1, "n": "a"}]}}
{"id": "t-seq-lambda-ret-arr", "expr": "(function(){[1]})()", "tags": ["targeted"]}
{"id": "t-seq-eval-arr", "expr": "$eval('[1]')", "tags": ["targeted"]}
{"id": "t-seq-zip", "expr": "$zip([1],[2])", "tags": ["targeted"]}
{"id": "t-seq-spread", "expr": "$spread({'a':1})", "tags": ["targeted"]}
{"id": "t-seq-each", "expr": "$each({'a':1}, function($v){$v})", "tags": ["targeted"]}
{"id": "t-order-numeric-keys-input", "expr": "$", "tags": ["targeted"], "input": {"b": 1, "2": 2, "1": 3}}
{"id": "t-order-numeric-keys-ctor", "expr": "{'b':1,'2':2,'1':3}", "tags": ["targeted"]}
{"id": "t-order-keys-fn", "expr": "$keys({'b':1,'2':2,'1':3})", "tags": ["targeted"]}
{"id": "t-order-group", "expr": "items{k: n}", "tags": ["targeted"], "input": {"items": [{"k": "b", "n": 1}, {"k": "2", "n": 2}, {"k": "1", "n": 3}]}}
{"id": "t-order-merge", "expr": "$merge([{'b':1},{'1':2}])", "tags": ["targeted"]}
{"id": "t-order-transform", "expr": "$ ~> |$|{'1':0}|", "tags": ["targeted"], "input": {"b": 1}}
{"id": "t-order-spread", "expr": "$spread({'b':1,'1':2})", "tags": ["targeted"]}
{"id": "t-order-string", "expr": "$string({'b':1,'1':2})", "tags": ["targeted"]}
{"id": "t-order-each", "expr": "$each({'b':1,'1':2}, function($v,$k){$k})", "tags": ["targeted"]}
{"id": "t-order-wild", "expr": "{'b':1,'1':2}.*", "tags": ["targeted"]}
{"id": "t-order-sift", "expr": "$sift({'b':1,'1':2}, function(){true})", "tags": ["targeted"]}
{"id": "t-order-lookup-multi", "expr": "$lookup([{'b':1},{'b':2}], 'b')", "tags": ["targeted"]}
{"id": "t-order-neg-key", "expr": "{'b':1,'-1':2,'01':3,'1.5':4,'4294967295':5,'4294967294':6}", "tags": ["targeted"]}
{"id": "t-eval-err-pos", "expr": "$eval('1 + ')", "tags": ["targeted"]}
{"id": "t-eval-err-code", "expr": "$eval('$undefinedfn()')", "tags": ["targeted"]}
{"id": "t-eval-inf", "expr": "$eval('1/0')", "tags": ["targeted"]}
{"id": "t-assert-msg", "expr": "$assert(false, 'custom')", "tags": ["targeted"]}
{"id": "t-assert-default", "expr": "$assert(false)", "tags": ["targeted"]}
{"id": "t-error-msg", "expr": "$error('custom')", "tags": ["targeted"]}
{"id": "t-error-obj", "expr": "$error({'a':1})", "tags": ["targeted"]}
{"id": "t-error-default", "expr": "$error()", "tags": ["targeted"]}
